<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="../network/waterloo_kitchener.net.xml"/>
        <route-files value="../routes/background.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="5400"/>
        <step-length value="1"/>
    </time>

    <processing>
        <time-to-teleport value="-1"/>
    </processing>

    <report>
        <no-step-log value="true"/>
        <duration-log.statistics value="true"/>
    </report>
</configuration>
