<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      Reference config for local SUMO GUI use after generating assets.
      The cloud runner supplies -n/-r directly so persistent /data paths
      do not need to be hard-coded here.
    -->
    <input>
        <net-file value="../network/waterloo_kitchener.net.xml.gz"/>
        <route-files value="../routes/background.rou.xml.gz"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="5400"/>
        <step-length value="1"/>
    </time>

    <processing>
        <time-to-teleport value="-1"/>
    </processing>

    <report>
        <no-step-log value="true"/>
        <duration-log.statistics value="true"/>
    </report>
</configuration>
